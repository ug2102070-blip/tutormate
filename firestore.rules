rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.get('role', '');
    }

    function getUserTutorId() {
      return request.auth.token.get('tutorId', '');
    }

    function getStudentDocId() {
      return request.auth.token.get('studentDocId', '');
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' ||
        'admin' in request.auth.token.get('roles', [])
      );
    }

    function isTutor() {
      return isAuthenticated() && (
        getUserRole() == 'tutor' ||
        'tutor' in request.auth.token.get('roles', [])
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        getUserRole() == 'student' ||
        'student' in request.auth.token.get('roles', [])
      );
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Allow user to read own document, or admin, or tutor reading student doc
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isTutor() && resource.data.tutorId == getUserTutorId())
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ==========================================
    // TUTORS COLLECTION
    // ==========================================
    match /tutors/{tutorId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == tutorId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == tutorId || isAdmin() || (isTutor() && getUserTutorId() == tutorId));
      allow delete: if isAdmin();
    }

    // ==========================================
    // BATCHES COLLECTION
    // ==========================================
    match /batches/{batchId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTutor() && resource.data.tutorId == getUserTutorId()) ||
        (isStudent() && resource.data.tutorId == getUserTutorId())
      );
      allow create: if isTutor() && request.resource.data.tutorId == getUserTutorId();
      allow update, delete: if isTutor() && resource.data.tutorId == getUserTutorId() && request.resource.data.tutorId == getUserTutorId();
    }

    // ==========================================
    // STUDENTS COLLECTION
    // ==========================================
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTutor() && resource.data.tutorId == getUserTutorId()) ||
        (isStudent() && resource.data.tutorId == getUserTutorId() && (resource.data.authUid == request.auth.uid || resource.data.id == getStudentDocId()))
      );
      allow create: if isTutor() && request.resource.data.tutorId == getUserTutorId();
      // Client-side update for student invite claiming REMOVED.
      // Must be performed via claimStudentInvite Server Action using Firebase Admin SDK.
      allow update: if (isTutor() && resource.data.tutorId == getUserTutorId()) || isAdmin();
      allow delete: if (isTutor() && resource.data.tutorId == getUserTutorId()) || isAdmin();
    }

    // ==========================================
    // ATTENDANCE COLLECTION
    // ==========================================
    match /attendance/{attendanceId} {
      // Tutor and Admin can read attendance directly.
      // Students access sanitized attendance history exclusively via Server Action.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTutor() && resource.data.tutorId == getUserTutorId())
      );
      allow create: if isTutor() && request.resource.data.tutorId == getUserTutorId();
      allow update, delete: if isTutor() && resource.data.tutorId == getUserTutorId();
    }

    // ==========================================
    // FEES COLLECTION
    // ==========================================
    match /fees/{feeId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTutor() && resource.data.tutorId == getUserTutorId()) ||
        (isStudent() && resource.data.tutorId == getUserTutorId() && resource.data.studentId == getStudentDocId())
      );
      allow create: if isTutor() && request.resource.data.tutorId == getUserTutorId();
      allow update, delete: if isTutor() && resource.data.tutorId == getUserTutorId();
    }

    // ==========================================
    // PRESENCE COLLECTION
    // ==========================================
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // DOUBTS COLLECTION & MESSAGES SUBCOLLECTION
    // ==========================================
    match /doubts/{doubtId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTutor() && resource.data.tutorId == getUserTutorId()) ||
        (isStudent() && resource.data.studentAuthUid == request.auth.uid)
      );
      allow create: if isStudent() && request.resource.data.tutorId == getUserTutorId() && request.resource.data.studentAuthUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isTutor() && resource.data.tutorId == getUserTutorId()) ||
        (isStudent() && resource.data.studentAuthUid == request.auth.uid)
      );
      allow delete: if isAdmin() || (isTutor() && resource.data.tutorId == getUserTutorId());

      match /messages/{messageId} {
        allow read, create, update, delete: if isAuthenticated() && (
          isAdmin() ||
          (isTutor() && get(/databases/$(database)/documents/doubts/$(doubtId)).data.tutorId == getUserTutorId()) ||
          (isStudent() && get(/databases/$(database)/documents/doubts/$(doubtId)).data.studentAuthUid == request.auth.uid)
        );
      }
    }

    // ==========================================
    // FEEDBACK COLLECTION
    // ==========================================
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow write: if false; // Submitted securely via submitFeedbackAction Server Action (Admin SDK)
    }

  }
}

